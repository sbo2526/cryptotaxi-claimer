# ── Crypto Taxi — .gitignore ────────────────────────────────────────────────
# Logs
*.log
*.log.*

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/

# Credentials and runtime state must never enter Git.
.env
.env.*
!.env.example
data/
accounts.json
email_account.json
status.json
earnings.json
banned_accounts.json
creator_status.json
referral_faker_status.json
proxy_state.json
proxies.txt

# System files
*.service
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Reports (generated daily)
reports/

# WPF project (not needed for Railway deployment)
CryptoTaxiWPF/
